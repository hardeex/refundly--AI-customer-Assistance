# =============================================================================
# AI-Powered Customer Support Refund System
# Environment Configuration
# =============================================================================
#
# Copy this file to `.env` and replace the placeholder values with your
# environment-specific configuration.
#

# Example:
#   cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME="AI-Powered Customer Support Refund System"

# Available environments:
#   development
#   production
ENVIRONMENT=development

# Enable detailed error/debug information.
# Set to false in production.
DEBUG=true


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection URL for local development.
#
# Format:
# postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
#
# Replace the values below with your local PostgreSQL credentials.
DATABASE_URL="postgresql+psycopg://user:password@127.0.0.1:5432/customer-refund-system"


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Allowed frontend origins.
# Add your production frontend URL when deploying.
CORS_ORIGINS=["http://localhost:3000"]


# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------

# Generate a secure secret with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
JWT_SECRET_KEY="replace-with-a-secure-random-secret"

JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password reset token lifetime in minutes.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15


# -----------------------------------------------------------------------------
# Anthropic / AI Configuration
# -----------------------------------------------------------------------------

# Your Anthropic API key.
ANTHROPIC_API_KEY=""


# ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_MODEL=""

# API version used by your application/SDK.
ANTHROPIC_VERSION=""

# Request timeout in seconds.
ANTHROPIC_TIMEOUT=120


# -----------------------------------------------------------------------------
# Seed script
# -----------------------------------------------------------------------------

# Optional. When set, `seed_data.py` stores this exact value as the demo
# tenant's API key instead of generating a random one - only so it can match
# BACKEND_API_KEY in the frontend's env file without copy-pasting a fresh key
# after every reseed. Leave unset for a real deployment; the seed script
# generates a proper random key by default.
DEMO_API_KEY="rf_live_demo_northwind_outfitters_local_dev_only"


# -----------------------------------------------------------------------------
# Email / SMTP Configuration
# -----------------------------------------------------------------------------

# SMTP mail driver.
MAIL_MAILER=smtp

# Gmail SMTP server.
MAIL_HOST=smtp.gmail.com

# Common Gmail SMTP ports:
#   465 = SSL
#   587 = STARTTLS
#
# Make sure MAIL_ENCRYPTION matches the configuration expected by your
# application/SMTP library.
MAIL_PORT=465

# Gmail account used to send emails.
MAIL_USERNAME="your-email@gmail.com"

# IMPORTANT:
# For Gmail, use a Google App Password rather than your normal Gmail password.
MAIL_PASSWORD="your-gmail-app-password"

MAIL_ENCRYPTION=tls

# Email address shown as the sender.
MAIL_FROM_ADDRESS="your-email@gmail.com"

# Sender display name.
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Local Mail Logging / Development
# -----------------------------------------------------------------------------
#
# For local development, you can use your application's log mail driver
# instead of a real SMTP server, if supported by the application.
#
# Uncomment and configure these values according to your mail implementation.
#
# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
#
# Production checklist:
#
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=false
# 3. Generate a strong JWT_SECRET_KEY
# 4. Use production database credentials
# 5. Configure production CORS origins
# 6. Configure your real Anthropic API credentials
# 7. Configure production SMTP credentials
# 8. Never commit `.env` or other files containing secrets
#
# -----------------------------------------------------------------------------

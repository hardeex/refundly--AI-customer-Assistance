# =============================================================================
# Refund System Frontend - Environment Configuration
# =============================================================================
#
# Copy this file to `.env.local` and fill in the values below.
#
#   cp .env.example .env.local
#
# =============================================================================


# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend. Used server-side only (in Next.js route
# handlers/server components) - the browser never talks to the backend
# directly, so this can point at a hostname only reachable from the server
# (e.g. "http://backend:8000" inside docker-compose).
BACKEND_API_URL="http://localhost:8000"

# The tenant API key the backend's seed script creates. Kept server-side:
# used by the Next.js route handlers that call the customer-facing endpoints
# on the customer's behalf, so it's never sent to the browser.
#
# This matches the DEMO_API_KEY default in the backend's own .env.example -
# both need the same value, since the backend hashes and stores whatever
# DEMO_API_KEY it was seeded with, and this is what the frontend presents to
# authenticate as that tenant. If you change DEMO_API_KEY on the backend (or
# unset it, so the seed script generates a real random key instead), update
# this to match and restart the frontend container/dev server.
BACKEND_API_KEY="rf_live_demo_northwind_outfitters_local_dev_only"


# -----------------------------------------------------------------------------
# Display
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME="Northwind Outfitters Support"

# Public - safe to expose to the browser (FastAPI's auto-generated Swagger UI
# is a public, read-only page). Linked from the site footer on every page.
# Change the port/host to match wherever the backend is actually reachable
# from a browser (not the docker-compose internal hostname).
NEXT_PUBLIC_BACKEND_DOCS_URL="http://localhost:8000/docs"
